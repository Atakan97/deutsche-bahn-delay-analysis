# Environment variable template
# Supabase / PostgreSQL connection
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Project ref for this project: your-project-ref
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Individual Supabase connection parameters
SUPABASE_HOST=db.your-project-ref.supabase.co
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres
SUPABASE_PASSWORD=your-supabase-password-here
SUPABASE_SCHEMA=public

# FastAPI model-serving URL
#
# Local dev: http://localhost:8000
# Production: https://[YOUR-HF-USERNAME]-deutsche-bahn-delay-api.hf.space
API_URL=http://localhost:8000

# Free DB API Marketplace credentials, used by StaDa and Timetables.
# Create one application subscription in the DB API Marketplace; never commit
# these values. DB_CLIENT_ID and DB_API_KEY are required for the data pipeline.
DB_CLIENT_ID=your-db-client-id
DB_API_KEY=your-db-api-key
